# Environment variables — NEVER commit real secrets
.env
.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Expo / React Native
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/

# Native build folders (generated, do not commit)
/myApp/ios/
/myApp/android/
/myApp/app-example/

# Metro
.metro-health-check*

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# TypeScript
*.tsbuildinfo
*.orig.*

# Keys / Certs (extra safety net)
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
service-account*.json
*-service-account.json

# Installers / Binaries
*.exe
