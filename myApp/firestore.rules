rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own top-level user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Users can read/write their own daily progress subcollection
      match /dailyProgress/{dayId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Users can read their own weekly snapshots (written by Cloud Functions)
      match /weeklySnapshots/{snapshotId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Only Cloud Functions (admin) write here
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
